From ffc78120ba679f6af5d367a37e2a64b6892a3ee4 Mon Sep 17 00:00:00 2001
From: "Kurt Morris (AKA MasterOKhan)" <kurt.morris@me.com>
Date: Thu, 17 Jul 2025 02:17:15 -0700
Subject: [PATCH] Update sm7325-nothing-spacewar.dts

---
 .../boot/dts/qcom/sm7325-nothing-spacewar.dts | 228 ++++++++++++++++--
 1 file changed, 207 insertions(+), 21 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
index 4f08a2da631d3f..c5507c5bfe245d 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
@@ -380,6 +380,38 @@
 		regulator-always-on;
 		vin-supply = <&vph_pwr>;
 	};
+
+	vreg_s4b: regulator-s4b {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_s4b";
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+		regulator-always-on;
+	};
+
+	vreg_l1b: regulator-l1b {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_l1b";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	vreg_l2b: regulator-l2b {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_l2b";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	vreg_l5b: regulator-l5b {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_l5b";
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+		regulator-always-on;
+	};
 };
 
 &apps_rsc {
@@ -1363,39 +1395,133 @@
 };
 
 &sound {
-	compatible = "qcom,sm7325-sndcard",
-		     "qcom,sm8250-sndcard";
-
+	compatible = "qcom,sm7325-sndcard", "qcom,sm8250-sndcard";
 	model = "NP1";
 
 	pinctrl-0 = <&pri_mi2s_bck_active &pri_mi2s_din_active
-		     &pri_mi2s_dout_active &pri_mi2s_ws_active>;
+	             &pri_mi2s_dout_active &pri_mi2s_ws_active>;
 	pinctrl-1 = <&pri_mi2s_sleep>;
-	pinctrl-names = "default",
-			"sleep";
-
-	mm1-dai-link {
+	pinctrl-2 = <&pri_swr_clk_active &pri_swr_data_active>;
+	pinctrl-3 = <&pri_swr_sleep>;
+	pinctrl-names = "default", "sleep", "swr", "swr-sleep";
+
+	audio-routing =
+		/* Analog microphones */
+		"AMIC1", "Analog Mic1",
+		"Analog Mic1", "MIC BIAS1",
+		"AMIC2", "Analog Mic2",
+		"Analog Mic2", "MIC BIAS2",
+		"AMIC3", "Analog Mic3",
+		"Analog Mic3", "MIC BIAS3",
+		"AMIC4", "Analog Mic4",
+		"Analog Mic4", "MIC BIAS1",
+        "AMIC5", "Analog Mic5",
+        "Analog Mic5", "MIC BIAS2",
+        "DMIC1", "Digital Mic1",
+        "DMIC2", "Digital Mic2",
+
+		/* Headphones */
+		"HPHL", "Headphones",
+		"HPHR", "Headphones",
+
+		/* Speakers */
+		"SpkrLeft IN", "SpkrLeft DAI",
+		"SpkrRight IN", "SpkrRight DAI";
+
+	dai-link@0 {
 		link-name = "MultiMedia1";
+		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>; };
+	};
 
-		cpu {
-			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	dai-link@1 {
+		link-name = "Primary MI2S Playback";
+		cpu { sound-dai = <&q6afedai 1>; };
+		platform { sound-dai = <&q6routing>; };
+		codec {
+			sound-dai = <&tfa9873_l 0>, <&tfa9873_r 0>;
 		};
 	};
 
-	i2s-dai-link {
-		link-name = "I2S Playback";
+	dai-link@2 {
+		link-name = "WCD9385 RX Playback";
+		cpu { sound-dai = <&q6afedai 2>; };
+		platform { sound-dai = <&q6routing>; };
+		codec { sound-dai = <&wcd9385_rx 0>; };
+	};
 
-		cpu {
-			sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
-		};
+	dai-link@3 {
+		link-name = "WCD9385 TX Capture";
+		cpu { sound-dai = <&q6afedai 3>; };
+		platform { sound-dai = <&q6routing>; };
+		codec { sound-dai = <&wcd9385_tx 1>; };
+	};
 
-		platform {
-			sound-dai = <&q6routing>;
-		};
+	dai-link@4 {
+		link-name = "WCD9385 VA Capture";
+		cpu { sound-dai = <&q6afedai 4>; };
+		platform { sound-dai = <&q6routing>; };
+		codec { sound-dai = <&wcd9385_va 2>; };
+	};
 
-		codec {
-			sound-dai = <&tfa9873_l 0>, <&tfa9873_r 0>;
-		};
+	dai-link@5 {
+		link-name = "WCD9385 WSA Playback";
+		cpu { sound-dai = <&q6afedai 5>; };
+		platform { sound-dai = <&q6routing>; };
+		codec { sound-dai = <&wcd9385_wsa 3>; };
+	};
+};
+
+&swr0 {
+	wcd9385_rx: codec@0 {
+		compatible = "qcom,wcd9385";
+		reg = <0>;
+		#sound-dai-cells = <1>;
+		clocks = <&rpmhcc>;
+		clock-names = "mclk";
+		vdd-buck-supply = <&vreg_s4b>;
+		vdd-rxtx-supply = <&vreg_l2b>;
+		vdd-mic-bias-supply = <&vreg_l5b>;
+		vddio-supply = <&vreg_l1b>;
+	    status = "okay";
+	};
+
+	wcd9385_tx: codec@1 {
+		compatible = "qcom,wcd9385";
+		reg = <1>;
+		#sound-dai-cells = <1>;
+		clocks = <&rpmhcc>;
+		clock-names = "mclk";
+		vdd-buck-supply = <&vreg_s4b>;
+		vdd-rxtx-supply = <&vreg_l2b>;
+		vdd-mic-bias-supply = <&vreg_l5b>;
+		vddio-supply = <&vreg_l1b>;
+	    status = "okay";
+	};
+
+	wcd9385_va: codec@2 {
+		compatible = "qcom,wcd9385";
+		reg = <2>;
+		#sound-dai-cells = <1>;
+		clocks = <&rpmhcc>;
+		clock-names = "mclk";
+		vdd-buck-supply = <&vreg_s4b>;
+		vdd-rxtx-supply = <&vreg_l2b>;
+		vdd-mic-bias-supply = <&vreg_l5b>;
+		vddio-supply = <&vreg_l1b>;
+	    status = "okay";
+	};
+
+	wcd9385_wsa: codec@3 {
+		compatible = "qcom,wcd9385";
+		reg = <3>;
+		#sound-dai-cells = <1>;
+		clocks = <&rpmhcc>;
+		clock-names = "mclk";
+		vdd-buck-supply = <&vreg_s4b>;
+		vdd-rxtx-supply = <&vreg_l2b>;
+		vdd-mic-bias-supply = <&vreg_l5b>;
+		vddio-supply = <&vreg_l1b>;
+	    status = "okay";
 	};
 };
 
@@ -1585,6 +1711,66 @@
 		drive-strength = <8>;
 		bias-pull-up;
 	};
+
+	pri_mi2s_bck_active: pri-mi2s-bck-active-state {
+		pins = "gpio97";
+		function = "mi2s0_sck";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_din_active: pri-mi2s-din-active-state {
+		pins = "gpio98";
+		function = "mi2s0_data0";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_dout_active: pri-mi2s-dout-active-state {
+		pins = "gpio99";
+		function = "mi2s0_data1";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_ws_active: pri-mi2s-ws-active-state {
+		pins = "gpio100";
+		function = "mi2s0_ws";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	pri_mi2s_sleep: pri-mi2s-sleep-state {
+		pins = "gpio97", "gpio98", "gpio99", "gpio100";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	pri_swr_clk_active: pri-swr-clk-active {
+		pins = "gpio145";
+		function = "swr_tx_clk";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	pri_swr_data_active: pri-swr-data-active {
+		pins = "gpio158";
+		function = "swr_tx_data";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	pri_swr_sleep: pri-swr-sleep {
+		pins = "gpio145", "gpio158";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
 };
 
